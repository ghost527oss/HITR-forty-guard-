{
  "$schema": "https://schema.up.railway.app/railway.schema.json",
  "build": {
    "builder": "dockerfile",
    "dockerfilePath": "Dockerfile"
  },
  "deploy": {
    "healthcheckPath": "/api/health",
    "healthcheckTimeout": 300,
    "restartPolicyType": "onFailure",
    "restartPolicyMaxRetries": 10
  }
}
