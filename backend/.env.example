# ─────────────────────────────────────────────────────────────────────────────
# HITR backend environment template.
#
# HOW TO USE (local development):
#   1. Copy this file:  cp backend/.env.example backend/.env
#   2. Fill in real values in backend/.env  (that file is GITIGNORED — never committed)
#   3. Restart the backend.
#
# FOR PRODUCTION (Vercel): do NOT use a .env file. Add these as Environment
# Variables in the Vercel dashboard (Settings → Environment Variables) of the
# BACKEND project. See docs/secrets.md.
#
# GOLDEN RULE: real keys only ever live in (a) your local gitignored .env or
# (b) Vercel environment variables. Never in git, never in the frontend,
# never in chat messages, never in code.
# ─────────────────────────────────────────────────────────────────────────────

# Application
APP_ENV=development

# FortyGuard Temperature API (the heat data key).
# Leave empty to run with the offline mock heat model.
FORTYGUARD_API_KEY=
# Plan tier: basic | startup | premium  (default: basic)
FORTYGUARD_PLAN=basic
# Optional base URL override (leave blank to use the default)
# FORTYGUARD_BASE_URL=https://api.fortyguard.com

# Heat provider selection: "auto" (real when key present, else mock), "real", "mock"
HEAT_PROVIDER=auto

# Gemini (optional, not wired yet)
GEMINI_API_KEY=

# Supabase (optional, not wired yet — publishable key is public, secret key is SENSITIVE)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Knowledge provider: "auto" (supabase if configured, else seed), "supabase", "seed"
KNOWLEDGE_PROVIDER=auto
