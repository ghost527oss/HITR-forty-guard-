# Copy this file to .env and fill in real values. NEVER commit .env.

# FortyGuard Temperature API (trial credits from the hackathon dashboard)
FORTYGUARD_API_KEY=

# Gemini (Google AI Studio) for the AI assistant (optional)
GEMINI_API_KEY=

# Supabase (Postgres + PostGIS knowledge DB)
#   URL      -> your Supabase project URL, e.g. https://xxxx.supabase.co
#   PUBLISH  -> the public anon key (Settings -> API -> publishable/anon). Safe to be public.
#   SECRET   -> the secret/service key (Settings -> API). SENSITIVE: keep only in .env.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Application
APP_ENV=development
# "mock" will serve sample temperature data when no API key is set (for dev/demo)
HEAT_PROVIDER=auto
# "auto" uses Supabase when configured, else bundled seed knowledge
KNOWLEDGE_PROVIDER=auto
